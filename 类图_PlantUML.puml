@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

title 图书馆借阅管理系统 实验一至四 简化版

abstract class Resource {
  - m_id : string
  - m_title : string
  - m_publisher : string
  - m_price : double
  - m_left : int
  - m_total : int
  + Resource()
  + Resource(id, title, publisher, price, total)
  + ~Resource() <<virtual>>
  + getId() : string
  + getTitle() : string
  + getPublisher() : string
  + getPrice() : double
  + getLeft() : int
  + getTotal() : int
  + valid() : bool <<virtual>>
  + isAvailable() : bool
  + setTitle(title) : bool
  + setPublisher(publisher) : bool
  + setPrice(price) : bool
  + setTotal(total) : bool
  + addCopies(count) : bool
  + reduceCopies(count) : bool
  + borrowOne() : bool
  + returnOne() : bool
  + {abstract} show() : void
  + {abstract} getType() : string
  # showCommon() : void
}

class Book {
  - m_author : string
  - m_isbn : string
  - m_pages : int
  + Book()
  + Book(id, title, author, publisher, isbn, price, pages, total)
  + getAuthor() : string
  + getISBN() : string
  + getPages() : int
  + setAuthor(author) : bool
  + setISBN(isbn) : bool
  + setPages(pages) : bool
  + {static} validISBN(isbn) : bool
  + valid() : bool
  + show() : void
  + getType() : string
}

class Magazine {
  - m_issue : string
  - m_month : int
  + Magazine()
  + Magazine(id, title, publisher, price, issue, month, total)
  + getIssue() : string
  + getMonth() : int
  + setIssue(issue) : bool
  + setMonth(month) : bool
  + valid() : bool
  + show() : void
  + getType() : string
}

class Digital {
  - m_url : string
  - m_format : string
  - m_sizeMB : double
  + Digital()
  + Digital(id, title, provider, price, url, format, sizeMB, total)
  + getUrl() : string
  + getFormat() : string
  + getSizeMB() : double
  + setUrl(url) : bool
  + setFormat(format) : bool
  + setSizeMB(sizeMB) : bool
  + valid() : bool
  + show() : void
  + getType() : string
}

class Library {
  - m_name : string
  - m_items : vector<Resource*>
  + Library(name)
  + ~Library()
  + getName() : string
  + size() : int
  + add(item) : bool
  + remove(id) : bool
  + find(id) : Resource*
  + showAll() : void
}

class Student {
  + {static} MaxLoans : int = 60
  - m_name : string
  - m_id : string
  - m_borrowed : int
  - m_limit : int
  - m_loans : Resource*[60]
  + Student()
  + Student(name, id, limit)
  + getName() : string
  + getId() : string
  + getBorrowed() : int
  + getLimit() : int
  + valid() : bool
  + setName(name) : bool
  + setId(id) : bool
  + setLimit(limit) : bool
  + borrow(item) : bool
  + giveBack(item) : bool
  + hasBorrowed(item) : bool
  + show() : void
  + showLoans() : void
}

Resource <|-- Book
Resource <|-- Magazine
Resource <|-- Digital
Library "1" *-- "0..*" Resource : 拥有并释放
Student "0..*" --> "0..60" Resource : 当前借阅

note top of Library
实验四：组合类使用基类指针容器，
通过虚函数统一显示各类资源。
入馆前判断 valid()，借出未还时禁止删除。
end note

note top of Student
实验二：借还操作体现依赖关系。
记录容量和借阅上限统一检查。
禁止复制，不负责释放馆藏资源。
end note
@enduml
